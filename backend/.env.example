# Copiez ce fichier en ".env" (dans le dossier backend) et remplissez les valeurs.
# Ne commitez JAMAIS le fichier .env.

PORT=5000

# Longue chaîne aléatoire, identique à celle de l'hébergeur si vous voulez garder les sessions
JWT_SECRET=

# Supabase : Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Google AI Studio
GEMINI_API_KEY=
# Modèles Gemini essayés dans l'ordre (secours automatique si saturé)
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest

# Stripe (utilisez les clés de TEST sk_test_... en local)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MENSUEL=
STRIPE_PRICE_TRIMESTRIEL=
STRIPE_PRICE_ANNUEL=

# URL du frontend (pour les redirections après paiement)
FRONTEND_URL=http://localhost:3000

# Démo publique : nombre maximum de corrections IA gratuites par jour (tous visiteurs)
# DEMO_LIMITE_JOUR=200

# Connexion avec Google : Google Cloud Console > API et services > Identifiants > ID client OAuth (application Web)
# (même valeur que REACT_APP_GOOGLE_CLIENT_ID côté frontend ; ce n'est pas un secret)
GOOGLE_CLIENT_ID=

# Courriel de bienvenue (facultatif) : adresse Gmail + « mot de passe d'application » (Compte Google > Sécurité)
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
# SMTP_HOTE=smtp.gmail.com
# SMTP_PORT=465

# Envoi par Brevo (recommandé en production : Railway bloque le SMTP sortant)
# Clé : brevo.com > Paramètres > SMTP & API > Clés API. Expéditeur à valider dans Expéditeurs, domaines et IP.
BREVO_API_KEY=
EXPEDITEUR_EMAIL=
